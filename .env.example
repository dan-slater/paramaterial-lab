# paramaterial lab — runtime environment for `node build` (adapter-node).
# Copy to .env next to build/ and edit. Contains NO secrets: the app needs none.
# The Claude chat is bring-your-own-key in the visitor's browser; never put an
# Anthropic key here or anywhere on the server.

# Public URL the site is served at. Required in production: SvelteKit uses it for
# CSRF checks on form posts, and it makes session cookies `Secure` over https.
ORIGIN=https://paramaterial.danielslater.dev

# Where Node listens. Bind to loopback; Cloudflare (tunnel or proxy) is the only
# way in. adapter-node's own defaults are 0.0.0.0:3000, so always set these.
HOST=127.0.0.1
PORT=3080

# Directory for the SQLite file (accounts, saved projects). Created if missing.
# Relative paths resolve against the service's WorkingDirectory.
DATA_DIR=./data

# Largest request body the server accepts. CSV import is parsed in the browser
# and never uploaded, so this only bounds saved-report payloads; it is set
# above the importer's 25 MB file cap so a future server-side import fits.
BODY_SIZE_LIMIT=30M

# Behind Cloudflare every request arrives from the tunnel/proxy. Read the real
# visitor address from Cloudflare's header so per-IP rate limits on sign-up and
# sign-in work. Only safe when the origin is reachable through Cloudflare alone.
ADDRESS_HEADER=CF-Connecting-IP

# Set to false to close registration. Existing accounts can still sign in, and
# anonymous use (presets, CSV import, chat) is unaffected.
ALLOW_SIGNUP=true
